{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/shorten",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:short_code(\\d{6})",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|shorten|\\d{6}).*)",
      "destination": "/index.html"
    }
  ]
}
